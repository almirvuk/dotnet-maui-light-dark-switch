<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiThemeDemo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MauiThemeDemo.Pages"
    Title="MauiThemeDemo">

    <TabBar>
        <ShellContent
            Title="Basics"
            Icon="tab_basics.png"
            ContentTemplate="{DataTemplate pages:BasicsPage}"
            Route="BasicsPage" />

        <ShellContent
            Title="Styled"
            Icon="tab_styled.png"
            ContentTemplate="{DataTemplate pages:StyledPage}"
            Route="StyledPage" />

        <ShellContent
            Title="Code"
            Icon="tab_code.png"
            ContentTemplate="{DataTemplate pages:CodePage}"
            Route="CodePage" />

        <ShellContent
            Title="Settings"
            Icon="tab_settings.png"
            ContentTemplate="{DataTemplate pages:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>
